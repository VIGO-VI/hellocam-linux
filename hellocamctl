def cmd_info(args) -> int:
    for cam in discover(any_id=args.any_id):
        label = KNOWN_IDS.get((cam.vid, cam.pid), "unrecognised")
        print("camera   : %04x:%04x  %s  (%s)" % (cam.vid, cam.pid, cam.product, label))
        print("usb      : %s  (bus %d dev %d, bcdDevice %d.%02d)"
              % (cam.usb_node, cam.bus, cam.dev,
                 cam.bcd_device >> 8, cam.bcd_device & 0xFF))
        print("serial   : %s" % (cam.serial or "-"))
        for chain in cam.chains:
            ir = chain.ir_interface
            print("\n  UVC %d.%02x chain on control interface %d, clock %d Hz"
                  % (chain.bcd_uvc >> 8, chain.bcd_uvc & 0xFF,
                     chain.vc_interface, chain.clock_hz))
            print("    streaming interfaces : %s" %
                  ", ".join(str(i) for i in chain.streaming))
            for node in cam.nodes.get(chain.vc_interface, []):
                caps = v4l2_caps(node)
                kind = "capture" if caps.get("capture") else \
                       "metadata" if caps.get("metadata") else "?"
                print("    node                 : %-13s %s" % (node, kind))
            for unit in chain.units:
                if unit.kind == "extension":
                    tag = "MS-XU" if unit.is_msxu else "vendor XU"
                    print("    %-8s unit %-2d %s controls=%d advertised=%s"
                          % (tag, unit.unit_id, guid_str(unit.guid),
                             unit.num_controls,
                             ",".join("0x%02x" % s for s in unit.selectors) or "-"))
                    if unit.is_msxu:
                        for s in unit.selectors:
                            print("               selector 0x%02x = %s"
                                  % (s, MSXU_NAMES.get(s, "reserved")))
                elif unit.kind in ("camera-terminal", "processing-unit"):
                    print("    %-8s unit %-2d selectors=%s"
                          % (unit.kind.split("-")[0], unit.unit_id,
                             ",".join(str(s) for s in unit.selectors) or "-"))
            if ir is not None:
                print("    -> IR streaming interface: %d" % ir)
    return 0


def cmd_xu(args) -> int:
    cam = pick_camera(args)
    cam.force_usbfs = args.usbfs
    for chain in cam.chains:
        with open_xu(cam, chain, write=False) as usb:
            units = [u for u in chain.units if u.kind == "extension"]
            if args.unit is not None:
                units = [u for u in units if u.unit_id == args.unit]
            for unit in units:
                print("unit %d on interface %d  %s%s"
                      % (unit.unit_id, chain.vc_interface, guid_str(unit.guid),
                         "  [MS-XU]" if unit.is_msxu else ""))
                sels = args.selector or unit.selectors
                for sel in sels:
                    advertised = sel in unit.selectors
                    if not advertised:
                        if not args.probe:
                            print("  sel 0x%02x  not advertised in bmControls - "
                                  "refused (use --probe for a read-only GET_INFO)"
                                  % sel)
                            continue
                        print("  sel 0x%02x  NOT ADVERTISED - read-only probe" % sel)
                    try:
                        info = usb.info(chain.vc_interface, unit.unit_id, sel)
                        length = usb.length(chain.vc_interface, unit.unit_id, sel)
                    except Error as exc:
                        print("  sel 0x%02x  %s" % (sel, exc))
                        continue
                    caps = []
                    for bit, name in ((0, "GET"), (1, "SET"), (2, "AUTOUPDATE"),
                                      (3, "ASYNC")):
                        if info >> bit & 1:
                            caps.append(name)
                    line = ("  sel 0x%02x %-22s info=0x%02x [%s] len=%d"
                            % (sel, MSXU_NAMES.get(sel, "") if unit.is_msxu else "",
                               info, ",".join(caps) or "-", length))
                    if advertised and "GET" in caps and 0 < length <= 64:
                        vals = {}
                        # MS-XU Face Authentication GET_MIN/GET_RES carry no
                        # payload (bNumEntries == 0) but the driver still asks
                        # for the full length, which logs a "non compliance"
                        # warning.  Don't provoke it.
                        skip = (unit.is_msxu and sel == MSXU_FACE_AUTHENTICATION)
                        getters = [(GET_CUR, "cur"), (GET_DEF, "def"),
                                   (GET_MAX, "max")]
                        if not skip:
                            getters[1:1] = [(GET_MIN, "min")]
                            getters.append((GET_RES, "res"))
                        for req, name in getters:
                            try:
                                vals[name] = usb.get(chain.vc_interface, unit.unit_id,
                                                     sel, req, length).hex()
                            except Error:
                                vals[name] = "-"
                        line += "  " + " ".join("%s=%s" % (k, v) for k, v in vals.items())
                    print(line)
    return 0


def _face_auth_ctx(cam, usb, write):
    chain, unit = require_msxu(cam, MSXU_FACE_AUTHENTICATION)
    iface = chain.vc_interface
    uid = unit.unit_id
    cur = usb.get(iface, uid, MSXU_FACE_AUTHENTICATION, GET_CUR)
    return chain, unit, cur


def cmd_ir(args) -> int:
    cam = pick_camera(args)
    cam.force_usbfs = getattr(args, "usbfs", False)
    write = args.action in ("on", "off", "default")
    chain, unit = require_msxu(cam, MSXU_FACE_AUTHENTICATION)
    with open_xu(cam, chain, write=write) as usb:
        chain, unit, cur = _face_auth_ctx(cam, usb, write)
        uid, iface = unit.unit_id, chain.vc_interface
        target_iface = chain.ir_interface
        if target_iface is None:
            raise Error("this chain's MS-XU does not map to exactly one IR "
                        "streaming interface")
        current = parse_face_auth(cur)
        print("face authentication control: unit %d on interface %d" % (uid, iface))
        print("  streaming interfaces: %s" % chain.streaming)
        print("  GET_CUR: %s  %s" % (cur.hex(), _fmt_entries(current)))
        if args.action == "status":
            return 0

        if args.action == "default":
            payload = usb.get(iface, uid, MSXU_FACE_AUTHENTICATION, GET_DEF,
                              len(cur))
        else:
            flags = FACE_AUTH_D1 if args.action == "on" else FACE_AUTH_D0
            payload = build_face_auth(cur, target_iface, flags)
        if len(payload) < len(cur):
            payload = payload.ljust(len(cur), b"\0")

        print("  SET_CUR: %s  %s" % (payload.hex(), _fmt_entries(parse_face_auth(payload))))
        usb.set(iface, uid, MSXU_FACE_AUTHENTICATION, payload)
        back = usb.get(iface, uid, MSXU_FACE_AUTHENTICATION, GET_CUR, len(payload))
        ok = back == payload
        print("  GET_CUR: %s  %s" % (back.hex(), _fmt_entries(parse_face_auth(back))))
        print("  read-back %s" % ("matches" if ok else "DIFFERS"))
        return 0 if ok else 1


def _fmt_entries(entries) -> str:
    if not entries:
        return "(none)"
    return "; ".join("iface %d: %s" % (e["interface"], "/".join(e["modes"]))
                     for e in entries)


def cmd_meta(args) -> int:
    cam = pick_camera(args)
    cam.force_usbfs = getattr(args, "usbfs", False)
    write = args.action in ("on", "off")
    chain, unit = require_msxu(cam, MSXU_METADATA)
    with open_xu(cam, chain, write=write) as usb:
        uid, iface = unit.unit_id, chain.vc_interface
        cur = usb.get(iface, uid, MSXU_METADATA, GET_CUR, 4)
        mx = usb.get(iface, uid, MSXU_METADATA, GET_MAX, 4)
        print("metadata control: unit %d iface %d  cur=%s max=%s"
              % (uid, iface, cur.hex(), mx.hex()))
        if args.action == "status":
            return 0
        value = struct.unpack("<I", mx)[0] if args.action == "on" else 0
        usb.set(iface, uid, MSXU_METADATA, struct.pack("<I", value))
        back = usb.get(iface, uid, MSXU_METADATA, GET_CUR, 4)
        print("  set %d -> GET_CUR %s" % (value, back.hex()))
        return 0


# Linux 7.x exposes the MS-XU face authentication control natively once the
# driver maps it; see kernel/patches/.  The id is the driver's private user-class
# control in the proof of concept.
FACE_AUTH_CID = 0x00981900
VIDIOC_G_CTRL = 0xC008561B
VIDIOC_S_CTRL = 0xC008561C
FACE_AUTH_MODES = {0: "general purpose", 1: "alternating illumination",
                   2: "continuous illumination"}


def v4l2_face_auth(node: str):
    """Return (read, write) for the native control, or None if absent."""
    try:
        fd = os.open(node, os.O_RDWR)
    except OSError:
        return None

    def read():
        buf = bytearray(struct.pack("<iI", FACE_AUTH_CID, 0))
        fcntl.ioctl(fd, VIDIOC_G_CTRL, buf, True)
        return struct.unpack("<iI", bytes(buf))[1]

    def write(mode):
        fcntl.ioctl(fd, VIDIOC_S_CTRL, struct.pack("<iI", FACE_AUTH_CID, mode))

    try:
        read()
    except OSError:
        os.close(fd)
        return None
    return fd, read, write


def cmd_v4l2test(args) -> int:
    """Prove the kernel control drives the illuminator, with no helper path."""
    cam = pick_camera(args)
    node = ir_node(cam)
    backend = v4l2_face_auth(node)
    if backend is None:
        raise Error("no native face authentication control on %s "
                    "(is the proof-of-concept uvcvideo loaded?)" % node)
    fd, read, write = backend
    results = []

    def check(name, ok, detail=""):
        results.append(ok)
        print("[%s] %s%s" % ("PASS" if ok else "FAIL", name,
                             ("  - " + detail) if detail else ""))

    try:
        check("native V4L2 control present on %s" % node, True,
              "id 0x%08x, current mode %d (%s)"
              % (FACE_AUTH_CID, read(), FACE_AUTH_MODES.get(read(), "?")))
        original = read()

        write(1)
        check("VIDIOC_S_CTRL mode 1 accepted", read() == 1, "read back 1")
        lit = grab_frames(node, args.frames + 30) or []

        write(0)
        check("VIDIOC_S_CTRL mode 0 accepted", read() == 0, "read back 0")
        dark = grab_frames(node, args.frames + 30) or []

        if lit and dark:
            a = frame_stats(lit, tail=args.frames)
            b = frame_stats(dark, tail=args.frames)
            print("     IR mean in mode 1: %6.2f   mode 0: %6.2f"
                  % (a["mean"], b["mean"]))
            span = max(x for x in (abs(a["mean"] - b["mean"]),)) 
            check("mode changes the IR image", span > 0.5, "delta %.2f" % span)
        else:
            check("IR frames captured", False)
    finally:
        write(original)
        check("restored mode %d" % original, read() == original)
        os.close(fd)

    print("\n%d/%d checks passed" % (sum(results), len(results)))
    return 0 if all(results) else 1


def cmd_doctor(args) -> int:
    """Check that the things this tool depends on are actually present."""
    ok = True

    def line(state, what, detail=""):
        nonlocal ok
        ok = ok and state
        print("[%s] %-28s %s" % ("ok" if state else "!!", what, detail))

    v = sys.version_info
    line(v[:2] >= REQUIRED_PYTHON, "python",
         "%d.%d.%d (need >= %d.%d)"
         % (v.major, v.minor, v.micro, *REQUIRED_PYTHON))
    for tool, package in OPTIONAL_TOOLS.items():
        line(have(tool) or not args.strict, tool,
             "found" if have(tool) else "missing (install %s)" % package)

    try:
        cams = discover(any_id=False)
    except Error as exc:
        cams = []
        line(False, "descriptor read", str(exc))
    line(bool(cams), "supported camera", " ".join(
        "%04x:%04x" % (c.vid, c.pid) for c in cams) or "not found")
    if cams:
        cam = cams[0]
        chain, unit = require_msxu(cam, MSXU_FACE_AUTHENTICATION)
        line(True, "MS-XU face authentication",
             "unit %d, iface %d" % (unit.unit_id, chain.vc_interface))
        node = chain_node(cam, chain)
        caps = v4l2_caps(node)
        line(bool(caps), "IR node", "%s %s" % (node, caps.get("driver", "")))
        try:
            os.close(os.open(node, os.O_RDWR))
            line(True, "IR node writable", "control writes will work")
        except OSError as exc:
            line(False, "IR node writable", str(exc))
    print("\n%s" % ("all good" if ok else "problems above"))
    return 0 if ok else 1


def cmd_mic(args) -> int:
    """Record from the camera's own capture device and report the level."""
    cam = pick_camera(args)
    card = None
    want = "%04x:%04x" % (cam.vid, cam.pid)
    for name in sorted(os.listdir("/proc/asound")):
        if name.startswith("card") and \
                read_attr("/proc/asound/%s/usbid" % name, "") == want:
            card = name[4:]
    if card is None:
        raise Error("no ALSA card for this camera")
    if not have("arecord"):
        raise Error("arecord not found: install alsa-utils")
    fd, path = tempfile.mkstemp(prefix="hellocamctl-", suffix=".wav")
    os.close(fd)
    cmd = ["arecord", "-D", "hw:%s,0" % card, "-f", "S16_LE", "-r", "48000",
           "-c", "2", "-d", str(args.seconds), path]
    try:
        subprocess.run(cmd, check=True, timeout=args.seconds + 5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        with wave.open(path) as w:
            raw = w.readframes(w.getnframes())
            frames = w.getnframes()
    except (subprocess.SubprocessError, OSError, wave.Error) as exc:
        raise Error("recording failed: %s" % exc)
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    samples = struct.unpack("<%dh" % (len(raw) // 2), raw)
    peak = max(abs(v) for v in samples)
    print("card %s: %d frames at 48 kHz (%.1f s), peak amplitude %d"
          % (card, frames, frames / 48000.0, peak))
    print("verdict: %s" % ("SILENT (all samples zero)" if peak == 0
                           else "audio present"))
    return 0 if peak else 1


def cmd_capture(args) -> int:
    cam = pick_camera(args)
    node = ir_node(cam)
    print("IR node: %s" % node)
    frames = grab_frames(node, args.frames)
    if frames is None:
        raise Error("IR capture failed")
    print("IR capture: %s" % frame_stats(frames))
    if args.combined:
        rgb = next((n for c in cam.chains for n in cam.nodes.get(c.vc_interface, [])
                    if v4l2_caps(n).get("capture")
                    and c.ir_interface is None and n != node), None)
        if rgb:
            bg = subprocess.Popen(
                ["timeout", "12", "v4l2-ctl", "-d", rgb, "--stream-mmap=2",
                 "--stream-count=200"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            try:
                time.sleep(1)
                frames = grab_frames(node, args.frames)
                print("IR capture while %s streams: %s"
                      % (rgb, frame_stats(frames) if frames else "FAILED"))
            finally:
                bg.terminate()
                bg.wait(timeout=5)
    return 0


def cmd_test(args) -> int:
    """Prove the emitter path end to end.  This is the acceptance test."""
    cam = pick_camera(args)
    results = []

    def check(name, ok, detail=""):
        results.append((name, ok, detail))
        print("[%s] %s%s" % ("PASS" if ok else "FAIL", name,
                             ("  - " + detail) if detail else ""))

    node = ir_node(cam)
    check("IR video node present", True, node)

    chain, unit = require_msxu(cam, MSXU_FACE_AUTHENTICATION)
    with open_xu(cam, chain, write=True) as usb:
        chain, unit = require_msxu(cam, MSXU_FACE_AUTHENTICATION)
        uid, iface = unit.unit_id, chain.vc_interface
        check("MS-XU advertises FACE_AUTHENTICATION",
              MSXU_FACE_AUTHENTICATION in unit.selectors,
              "unit %d iface %d %s" % (uid, iface, guid_str(unit.guid)))
        check("MS-XU advertises METADATA",
              MSXU_METADATA in [s for u in chain.msxu for s in u.selectors])

        info = usb.info(iface, uid, MSXU_FACE_AUTHENTICATION)
        check("face auth supports GET+SET",
              bool(info & 1) and bool(info & 2), "info=0x%02x" % info)

        cur = usb.get(iface, uid, MSXU_FACE_AUTHENTICATION, GET_CUR)
        original = cur
        entries = parse_face_auth(cur)
        check("GET_DEF readable", True,
              usb.get(iface, uid, MSXU_FACE_AUTHENTICATION, GET_DEF,
                      len(cur)).hex())
        check("current mode decoded", bool(entries), _fmt_entries(entries))

        ir_iface = chain.ir_interface
        check("IR streaming interface identified",
              ir_iface in [e["interface"] for e in entries],
              "iface %s" % ir_iface)

        def set_mode(flags):
            payload = build_face_auth(original, ir_iface, flags)
            usb.set(iface, uid, MSXU_FACE_AUTHENTICATION, payload)
            back = usb.get(iface, uid, MSXU_FACE_AUTHENTICATION, GET_CUR,
                           len(payload))
            return payload, back

        try:
            payload_on, back_on = set_mode(FACE_AUTH_D1)
            check("SET_CUR D1 (illuminator strobing)", back_on == payload_on,
                  back_on.hex())
            lit = grab_frames(node, args.frames + 30) or []
            time.sleep(0.3)

            payload_off, back_off = set_mode(FACE_AUTH_D0)
            check("SET_CUR D0 (illumination off)", back_off == payload_off,
                  back_off.hex())
            dark = grab_frames(node, args.frames + 30) or []
            time.sleep(0.3)

            if lit and dark:
                a = frame_stats(lit, tail=args.frames)
                b = frame_stats(dark, tail=args.frames)
                print("     IR mean with D1: %6.2f   with D0: %6.2f"
                      % (a["mean"], b["mean"]))
                check("illuminator changes the IR image",
                      abs(a["mean"] - b["mean"]) > 0.5,
                      "delta %.2f" % (a["mean"] - b["mean"]))
            else:
                check("IR frames captured", False)
        finally:
            usb.set(iface, uid, MSXU_FACE_AUTHENTICATION, original)
            back = usb.get(iface, uid, MSXU_FACE_AUTHENTICATION, GET_CUR,
                           len(original))
            check("restored original value", back == original, back.hex())

    failed = [r for r in results if not r[1]]
    print("\n%d/%d checks passed" % (len(results) - len(failed), len(results)))
    return 1 if failed else 0


def cmd_dump(args) -> int:
    cam = pick_camera(args)
    print("usb node: %s" % cam.usb_node)
    for chain in cam.chains:
        for unit in chain.units:
            print("%-16s unit %-2d iface %d selectors=%s"
                  % (unit.kind, unit.unit_id, unit.interface,
                     ",".join("0x%02x" % s for s in unit.selectors) or "-"))
    return 0


# --------------------------------------------------------------------------

def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="hellocamctl", description=__doc__.split("\n")[1])
    p.add_argument("--any-id", action="store_true",
                   help="inspect any USB device with a UVC descriptor")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("info", help="print the UVC descriptor model of the camera")
    s.set_defaults(func=cmd_info)

    s = sub.add_parser("dump", help="list units and advertised selectors (short)")
    s.set_defaults(func=cmd_dump)

    s = sub.add_parser("xu", help="read extension-unit controls (read-only)")
    s.add_argument("--unit", type=int)
    s.add_argument("--selector", type=lambda v: int(v, 0), action="append")
    s.add_argument("--probe", action="store_true",
                   help="also GET_INFO/GET_LEN controls the descriptor does not "
                        "advertise (never SET)")
    s.add_argument("--usbfs", action="store_true",
                   help="use raw usbfs instead of UVCIOC_CTRL_QUERY")
    s.set_defaults(func=cmd_xu)

    s = sub.add_parser("ir", help="get/set the IR (face authentication) mode")
    s.add_argument("action", choices=["status", "on", "off", "default"])
    s.add_argument("--usbfs", action="store_true")
    s.set_defaults(func=cmd_ir)

    s = sub.add_parser("meta", help="get/set the MS-XU frame-metadata control")
    s.add_argument("action", choices=["status", "on", "off"])
    s.add_argument("--usbfs", action="store_true")
    s.set_defaults(func=cmd_meta)

    s = sub.add_parser("v4l2test",
                       help="prove the kernel face-authentication control works")
    s.add_argument("--frames", type=int, default=15)
    s.set_defaults(func=cmd_v4l2test)

    s = sub.add_parser("doctor", help="check dependencies and device access")
    s.add_argument("--strict", action="store_true",
                   help="treat optional capture tools as required")
    s.set_defaults(func=cmd_doctor)

    s = sub.add_parser("mic", help="record from the camera mic and report level")
    s.add_argument("--seconds", type=int, default=3)
    s.set_defaults(func=cmd_mic)

    s = sub.add_parser("capture", help="capture IR frames (and optionally RGB)")
    s.add_argument("--frames", type=int, default=20)
    s.add_argument("--combined", action="store_true", help="also stream RGB")
    s.set_defaults(func=cmd_capture)

    s = sub.add_parser("selftest", help="end-to-end emitter proof, with restore")
    s.add_argument("--frames", type=int, default=15)
    s.set_defaults(func=cmd_test)

    args = p.parse_args(argv)
    try:
        return args.func(args)
    except Error as exc:
        print("hellocamctl: %s" % exc, file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
