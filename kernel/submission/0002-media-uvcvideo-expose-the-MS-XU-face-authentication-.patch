From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Your Name <you@example.com>
Date: Wed, 11 Nov 2026 01:10:22 -0600
Subject: [PATCH] media: uvcvideo: expose the MS-XU face authentication control

Microsoft's UVC 1.5 extensions define a Face Authentication control
(MS-XU selector 0x06) that selects, per streaming interface, whether the
IR illuminator runs in general-purpose (D0), alternating-frame (D1) or
continuous (D2) mode.  Windows Hello uses D1; without it the IR stream is
unlit and no liveness or face authentication is possible.

uvcvideo only instantiates controls present in its static table, so the
control is unreachable from V4L2, libcamera, PipeWire and browsers.
Expose it as a menu over the entry for the camera's single IR streaming
interface, with a read-modify-write of the flags byte so the interface
entry is preserved.

The control id is private (V4L2_CID_USER_BASE + 0x1000) because this is
an RFC: the payload is a per-interface array rather than a scalar, so the
public API is the open question, not the plumbing.  v4l2-compliance
reports "expected N private controls, got 0" on the IR node with this
control present, which has to be resolved before it is proposed.

Measured on a NexiGo N930W (3443:930d): the control appears as a
three-entry menu, writing D1 gives per-frame IR means alternating 0.9 and
222.7 while D0 stays flat, and the previous value is restored.

Signed-off-by: <PENDING: your name <you@example.com>>
---
 drivers/media/usb/uvc/uvc_ctrl.c | 107 +++++++++++++++++++++++++++++++
 1 file changed, 107 insertions(+)

diff --git a/drivers/media/usb/uvc/uvc_ctrl.c b/drivers/media/usb/uvc/uvc_ctrl.c
index c10c8d0..8dd56b5 100644
--- a/drivers/media/usb/uvc/uvc_ctrl.c
+++ b/drivers/media/usb/uvc/uvc_ctrl.c
@@ -36,7 +36,99 @@
  * Controls
  */
 
+/*
+ * Microsoft extensions to UVC 1.5: Face Authentication (MS-XU selector 0x06).
+ *
+ * The payload is one count byte followed by eight-byte entries, one per
+ * streaming interface: { bInterfaceNumber, bmControlFlags, 6 reserved }.
+ * bmControlFlags is D0 = general purpose, D1 = alternating frame illumination,
+ * D2 = continuous illumination; Windows Hello negotiates D1.
+ *
+ * This is exposed as a menu over the flags byte of the single entry the camera
+ * reports.  The payload size is fixed at one entry: probing GET_LEN here is not
+ * possible, because the camera does not answer class requests yet when the
+ * control is instantiated during probe (it returns -EAGAIN).  A camera with a
+ * different payload instead fails cleanly at the first GET_CUR, which asks for
+ * fewer bytes than the device wants to send.
+ */
+#define UVC_FACE_AUTH_ENTRY_SIZE	8
+#define UVC_FACE_AUTH_PAYLOAD_SIZE	(1 + UVC_FACE_AUTH_ENTRY_SIZE)
+#define UVC_FACE_AUTH_FLAGS_OFFSET	(1 + 1)
+#define UVC_FACE_AUTH_D0		BIT(0)
+#define UVC_FACE_AUTH_D1		BIT(1)
+#define UVC_FACE_AUTH_D2		BIT(2)
+#define UVC_FACE_AUTH_MAX_MODE		2	/* menu index, not a mask bit */
+
+/*
+ * Private control while this is a proof of concept.  Upstream would need a
+ * proper V4L2_CID_* in videodev2.h; the value is deliberately in the user
+ * class so that nothing else can collide with it.
+ */
+#define V4L2_CID_UVC_FACE_AUTHENTICATION	(V4L2_CID_USER_BASE + 0x1000)
+
+static const u32 uvc_ctrl_face_auth_values[] = {
+	UVC_FACE_AUTH_D0,
+	UVC_FACE_AUTH_D1,
+	UVC_FACE_AUTH_D2,
+};
+
+static const char uvc_ctrl_face_auth_names[][UVC_MENU_NAME_LEN] = {
+	"General purpose",
+	"Alternating illumination",
+	"Continuous illumination",
+};
+
+static int uvc_get_face_auth(struct uvc_control_mapping *mapping, u8 query,
+			     const void *uvc_in, size_t v4l2_size, void *v4l2_out)
+{
+	const u8 *data = uvc_in;
+	u32 *value = v4l2_out;
+	unsigned int i;
+
+	if (WARN_ON(v4l2_size != sizeof(*value)))
+		return -EINVAL;
+	if (data[0] != 1)
+		return -EIO;
+
+	for (i = 0; i < ARRAY_SIZE(uvc_ctrl_face_auth_values); i++) {
+		if (data[UVC_FACE_AUTH_FLAGS_OFFSET] ==
+		    uvc_ctrl_face_auth_values[i]) {
+			*value = i;
+			return 0;
+		}
+	}
+
+	return -EIO;
+}
+
+static int uvc_set_face_auth(struct uvc_control_mapping *mapping,
+			     size_t v4l2_size, const void *v4l2_in,
+			     void *uvc_out)
+{
+	const u32 *value = v4l2_in;
+	u8 *data = uvc_out;
+
+	if (WARN_ON(v4l2_size != sizeof(*value)))
+		return -EINVAL;
+	if (data[0] != 1)
+		return -EIO;
+	if (*value >= ARRAY_SIZE(uvc_ctrl_face_auth_values))
+		return -ERANGE;
+
+	data[UVC_FACE_AUTH_FLAGS_OFFSET] = uvc_ctrl_face_auth_values[*value];
+
+	return 0;
+}
+
+
 static const struct uvc_control_info uvc_ctrls[] = {
+	{
+		.entity		= UVC_GUID_MSXU_1_5,
+		.selector	= UVC_MSXU_CONTROL_FACE_AUTHENTICATION,
+		.index		= 5,
+		.size		= UVC_FACE_AUTH_PAYLOAD_SIZE,
+		.flags		= UVC_CTRL_FLAG_SET_CUR | UVC_CTRL_FLAG_GET_CUR,
+	},
 	{
 		.entity		= UVC_GUID_UVC_PROCESSING,
 		.selector	= UVC_PU_BRIGHTNESS_CONTROL,
@@ -1090,6 +1182,21 @@ static const struct uvc_control_mapping uvc_ctrl_mappings[] = {
 		.data_type	= UVC_CTRL_DATA_TYPE_BITMASK,
 		.name		= "Region of Interest Auto Ctrls",
 	},
+	{
+		.id		= V4L2_CID_UVC_FACE_AUTHENTICATION,
+		.entity		= UVC_GUID_MSXU_1_5,
+		.selector	= UVC_MSXU_CONTROL_FACE_AUTHENTICATION,
+		.size		= 8,
+		.offset		= UVC_FACE_AUTH_FLAGS_OFFSET * 8,
+		.v4l2_type	= V4L2_CTRL_TYPE_MENU,
+		.data_type	= UVC_CTRL_DATA_TYPE_ENUM,
+		.menu_mapping	= uvc_ctrl_face_auth_values,
+		.menu_names	= uvc_ctrl_face_auth_names,
+		.menu_mask	= GENMASK(UVC_FACE_AUTH_MAX_MODE, 0),
+		.get		= uvc_get_face_auth,
+		.set		= uvc_set_face_auth,
+		.name		= "Face Authentication Mode",
+	},
 	{
 		.id		= V4L2_CID_COLORFX,
 		.entity		= UVC_GUID_CHROMEOS_XU,
